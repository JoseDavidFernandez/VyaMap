APP_NAME=VyaMap
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_USER_TIMEZONE=Europe/Madrid
# Inertia DevTools graba las props de cada página y en local no pide login.
# Fuera de local se desactiva siempre (AppServiceProvider). En local, activarlo
# solo mientras se use y borrar después storage/inertia-devtools.
INERTIA_DEVTOOLS_ENABLED=false

# Registro público: por defecto solo en local. En producción, las cuentas se
# crean con `php artisan users:create`. Descomentar solo para forzarlo
# (una variable vacía cuenta como false).
# REGISTRATION_ENABLED=true
# Máximo de cuentas: al alcanzarlo, el registro se cierra solo. Sin definir,
# sin límite. users:create no está sujeto a él.
# REGISTRATION_MAX_USERS=100

# Verificación del correo: por defecto obligatoria salvo en local. Sin
# verificar, una cuenta solo ve /email/verify (users:create ya las verifica).
# EMAIL_VERIFICATION=true

# Subida de fotos y avatares. Por defecto, desactivada en producción y
# activada en el resto; con false el servidor rechaza cualquier archivo nuevo.
# UPLOADS_ENABLED=false

# Solo detrás de un balanceador o proxy que termina HTTPS: sus IP/CIDR separadas
# por comas, o "*" si la aplicación no es accesible sin pasar por él (ver
# config/trustedproxy.php). Con Nginx en el propio servidor no hace falta.
# TRUSTED_PROXIES=10.0.0.0/8

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vyamap
DB_USERNAME=vyamap_dev
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# En producción con HTTPS:
# SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Búsqueda de ciudades fuera del catálogo local (https://www.geoapify.com/).
# Opcional: sin clave solo se encuentran las ciudades del catálogo.
GEOAPIFY_API_KEY=
