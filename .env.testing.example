# Plantilla del entorno de pruebas (PHPUnit).
# Copia este archivo a .env.testing y rellena los valores locales.
# .env.testing está en .gitignore: no lo añadas nunca al repositorio.
#
# IMPORTANTE: los tests usan RefreshDatabase, que borra y recrea todas las
# tablas. DB_DATABASE debe apuntar a una base de datos exclusiva para
# pruebas, nunca a la de desarrollo.

APP_ENV=testing

# Genera una clave propia con: php artisan key:generate --show
# (solo la muestra, no modifica .env) y pega el valor aquí.
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_test_database
DB_USERNAME=your_test_user
DB_PASSWORD=your_test_password
